# ---------------------------------------------------------------------------
# MEDI SYNC API - environment template. Copy to apps/api/.env and fill in.
# NEVER commit real values. No secret has a working default in production.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin of the API (used for CORS allow-list + cookie security)
APP_ORIGIN=http://localhost:4000
# Comma separated list of allowed browser origins (staff + patient portals)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database (PostgreSQL / Supabase) --------------------------------------
# The schema targets PostgreSQL. Copy the Session pooler connection string from
# Supabase: Project Settings -> Database -> Connection string.
#
# The password MUST be percent-encoded: # -> %23, @ -> %40, ? -> %3F,
# / -> %2F, space -> %20. Use the pooler host (the direct db.<ref>.supabase.co
# host is IPv6-only on most projects). Port 6543 is the transaction pooler and
# additionally needs ?pgbouncer=true&connection_limit=1.
DATABASE_URL="postgresql://postgres.<project-ref>:<encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Used by `prisma migrate`; may be the same string. If omitted, the API falls
# back to DATABASE_URL at runtime.
DIRECT_URL="postgresql://postgres.<project-ref>:<encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# The test suite runs on SQLite instead (`npm run db:sqlite`), no server needed:
# DATABASE_URL="file:./dev.db"
#
# Then, once only: npm run db:supabase   (generates, migrates and seeds)

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=replace-with-32-plus-random-bytes
REFRESH_TOKEN_PEPPER=replace-with-32-plus-random-bytes
# 32-byte base64 key used for AES-256-GCM field encryption at rest
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# --- Token / session policy ------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
IDLE_TIMEOUT_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Integrations (abstracted; stubs run when unset) -----------------------

# --- Development helpers (ignored when NODE_ENV=production) ----------------
# Exposes GET /api/v1/auth/dev/totp/<email> and shows password-reset tokens.
DEV_MFA_HELPER=true
DEV_SHOW_RESET_TOKENS=true
# Fixed TOTP secret used by the seed and the dev helper.
SEED_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP
