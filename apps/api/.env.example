# ---------------------------------------------------------------------------
# MEDI SYNC API - environment template. Copy to apps/api/.env and fill in.
# NEVER commit real values. No secret has a working default in production.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin of the API (used for CORS allow-list + cookie security)
APP_ORIGIN=http://localhost:4000
# Comma separated list of allowed browser origins (staff + patient portals)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database -------------------------------------------------------------
# Dev/test: SQLite (zero infra). Production: PostgreSQL, see docker-compose.yml
# DATABASE_URL="postgresql://medisync:medisync@localhost:5432/medisync?schema=public"
DATABASE_URL="file:./dev.db"

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=replace-with-32-plus-random-bytes
REFRESH_TOKEN_PEPPER=replace-with-32-plus-random-bytes
# 32-byte base64 key used for AES-256-GCM field encryption at rest
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# --- Token / session policy ----------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
IDLE_TIMEOUT_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Integrations (abstracted; stubs run when unset) ----------------------
EMAIL_PROVIDER=console
SMS_PROVIDER=console
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox

# --- Dev conveniences (hard-disabled when NODE_ENV=production) -----------
# Adds a dev-only endpoint that returns the current TOTP for a demo user.
DEV_MFA_HELPER=true
DEV_SHOW_RESET_TOKENS=true
